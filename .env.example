# Server configuration
PORT=8080

# Database configuration (PostgreSQL / Supabase)
DATABASE_URL=postgres://postgres:password@localhost:5432/factory?sslmode=disable

# HiveMQ Cloud MQTT Broker configuration
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=backend-service-go

# Computer Vision Webhook Security
VISION_BEARER_TOKEN=secret-vision-token

# Cross-Origin Resource Sharing (comma-separated or * for wildcard)
CORS_ALLOWED_ORIGINS=*
